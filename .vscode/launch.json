{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GGI1: Debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/active/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "GGI1: Build active file",
            "setupCommands": [
                {"text": "-enable-pretty-printing", "ignoreFailures": true},
                {"text": "-gdb-set debuginfod enabled off", "ignoreFailures": true}
            ]
        },
